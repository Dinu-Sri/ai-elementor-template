{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deshtech.local/schemas/page-blueprint.schema.json",
  "title": "Native Elementor Page Blueprint",
  "type": "object",
  "required": ["project", "design", "sections"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["page", "template"], "default": "page" },
    "page": {
      "type": "object",
      "required": ["title", "slug"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "default": "elementor_header_footer" },
        "status": { "type": "string", "enum": ["draft", "publish"], "default": "draft" }
      }
    },
    "template": {
      "type": "object",
      "required": ["title", "type"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["header", "footer", "section", "single-post", "popup"] },
        "status": { "type": "string", "enum": ["publish", "draft"], "default": "publish" }
      }
    },
    "design": {
      "type": "object",
      "required": ["route", "colors", "fonts"],
      "properties": {
        "route": { "type": "string", "minLength": 1 },
        "colors": {
          "type": "object",
          "required": ["primary", "secondary", "accent", "dark", "light"],
          "additionalProperties": { "type": "string" }
        },
        "fonts": {
          "type": "object",
          "required": ["heading", "body"],
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "content"],
        "properties": {
          "component": {
            "type": "string",
            "enum": ["DesignFoundation", "GalleryGrid", "HeroSplit", "OfferHero", "FeatureGrid", "IconHighlights", "InfoColumns", "PricingCards", "ProcessSteps", "ShortcodeSection", "ContentSplit", "StatsBand", "CtaBand", "FaqList", "ContactPanel", "HeaderSimple", "HeaderNavMenu", "FooterMultiColumn"]
          },
          "variant": { "type": "string" },
          "content": { "type": "object" },
          "style": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": false
}
