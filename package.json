{
  "name": "native-elementor-master-suite",
  "version": "0.7.0",
  "private": true,
  "description": "Reusable native Elementor compiler, WordPress bridge, site workflow, and SEO publishing toolkit.",
  "scripts": {
    "bridge:validate": "node ./tools/validate-plugin-release.js 0.7.0",
    "site:nice:products:check": "node ./sites/nice-lk/tools/import-ccc-products.js",
